#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// The stock lily58 shield enables OLED panel inversion (dark-on-light);
// the fireplace wants lit flames on a dark screen. The keymap is the last
// devicetree overlay, so the tweak lives here.
&oled { /delete-property/ inversion-on; };

/ {
    combos {
        compatible = "zmk,combos";

        // Lower + Raise pressed together toggles the org layer (on layers
        // base and org, so the same two-thumb press gets you back out).
        combo_org_toggle {
            timeout-ms = <100>;
            key-positions = <52 55>;
            bindings = <&tog 3>;
            layers = <0 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // German QWERTZ, laid out like a German ThinkPad. The OS keyboard
        // layout (de) does the letter mapping, so the keycodes below are
        // US-positional: &kp Y types z, &kp SEMI types ö, and so on.
        // The comments show what actually comes out.
        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BKSPC |
            // |  TAB  |  q  |  w  |  e   |  r   |  t   |                   |  z   |  u    |  i    |  o   |   p   |   ü   |
            // |  ^ °  |  a  |  s  |  d   |  f   |  g   |                   |  h   |  j    |  k    |  l   |   ö   |   ä   |
            // | SHIFT |  y  |  x  |  c   |  v   |  b   |   GUI  |  |  GUI  |  n   |  m    |  ,    |  .   |   -   | SHIFT |
            //                     | CTRL | ALT  | LOWER|  ENTER |  | SPACE | RAISE| ALTGR | CTRL  |

            display-name = "Base";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3     &kp N4        &kp N5                                 &kp N6  &kp N7         &kp N8     &kp N9   &kp N0    &kp BACKSPACE
&kp TAB    &kp Q   &kp W   &kp E      &kp R         &kp T                                  &kp Y   &kp U          &kp I      &kp O    &kp P     &kp LBKT
&kp GRAVE  &kp A   &kp S   &kp D      &kp F         &kp G                                  &kp H   &kp J          &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C      &kp V         &kp B   &kp LEFT_GUI    &kp RIGHT_GUI  &kp N   &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                           &kp LCTRL  &kp LEFT_ALT  &mo 1   &kp RET         &kp SPACE      &mo 2   &kp RIGHT_ALT  &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // Symbols are chosen for a *German* OS layout — the comments show
        // what actually gets typed. AltGr combos (RA) match the German
        // ThinkPad: { } [ ] \ | ~ € live on AltGr there too.
        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | UNLCK | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |  ^ °  |  !  |  "  |  §   |  $   |  %   |                   |  &   |  /    |  *    |  (   |   )   |   °   |
            // |       |  =  |  ß  |  +   |  {   |  }   |        |  | ->org |  [   |  ]    |  \    |  "|" |   ~   |   €   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Lower";
            bindings = <
&studio_unlock  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                     &trans     &trans     &trans         &trans                    &trans       &trans
&kp F1          &kp F2        &kp F3        &kp F4        &kp F5        &kp F6                           &kp F7     &kp F8     &kp F9         &kp F10                   &kp F11      &kp F12
&kp GRAVE       &kp EXCL      &kp AT        &kp HASH      &kp DOLLAR    &kp PRCNT                        &kp CARET  &kp AMPS   &kp KP_MULTIPLY &kp LS(N8)               &kp LS(N9)   &kp TILDE
&trans          &kp RPAR      &kp MINUS     &kp RBKT      &kp RA(N7)    &kp RA(N0)   &trans    &tog 3    &kp RA(N8) &kp RA(N9) &kp RA(MINUS)  &kp RA(NON_US_BACKSLASH)  &kp RA(RBKT) &kp RA(E)
                                            &trans        &trans        &trans       &trans    &trans    &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&trans  &trans        &trans     &trans             &trans       &trans                      &trans         &trans            &trans        &trans      &trans     &trans
&trans  &kp INSERT    &kp PSCRN  &kp K_APPLICATION  &kp X        &kp C                       &kp PG_UP      &kp C_PLAY_PAUSE  &kp UP_ARROW  &kp C_NEXT  &trans     &trans
&trans  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT     &kp F5       &kp CLCK                    &kp PAGE_DOWN  &kp LEFT          &kp DOWN      &kp UP      &kp RIGHT  &trans
&trans  &kp K_UNDO    &kp K_CUT  &kp K_COPY         &kp K_PASTE  &kp F     &trans    &trans  &trans         &trans            &trans        &trans      &trans     &trans
                                 &trans             &trans       &trans    &trans    &trans  &trans         &trans            &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // Spacemacs/evil + org-mode layer, toggled with Lower+Raise together
        // (same two-thumb press exits — see the combo above).
        //
        // Only the differences from Base are bound; everything else is
        // &trans so it falls through — this also keeps Lower and Raise fully
        // usable while org is on (org has the highest layer index, so any
        // non-transparent key here would shadow them).
        //
        // Differences: SPACE moves to the strong left thumb (evil leader),
        // ENTER to the right thumb, `<` on the home-row pinky (org-mode
        // structure editing / spacemacs; NON_US_BACKSLASH is the German ISO
        // `<` key), ^ where Backspace was.
        org_layer {
            display-name = "org";
            bindings = <
&trans                 &trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans  &kp GRAVE
&trans                 &trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&kp NON_US_BACKSLASH   &trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans         &trans  &trans  &trans  &trans  &trans  &trans     &trans    &trans  &trans  &trans  &trans  &trans  &trans
                               &trans  &trans  &trans  &kp SPACE  &kp ENTER &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
